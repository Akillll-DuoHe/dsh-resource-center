{
  "name": "dsh-resource-center",
  "version": "1.0.0",
  "description": "Resource Center for the DeepSeek Harness web GUI: one sidebar entry that inventories the installed plugin bundles and the running feature modules, grouped by kind. 资源中心：一个侧边栏入口，把已安装的插件包和正在运行的功能模块按类别列清楚。",
  "type": "module",
  "main": "./index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "resource-center",
    "plugin-manager"
  ],
  "license": "MIT",
  "author": {
    "name": "俯仰观照",
    "url": "https://github.com/Akillll-DuoHe"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akillll-DuoHe/dsh-resource-center.git"
  },
  "homepage": "https://github.com/Akillll-DuoHe/dsh-resource-center#readme",
  "bugs": {
    "url": "https://github.com/Akillll-DuoHe/dsh-resource-center/issues"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
